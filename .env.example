# Copy to .env (git-ignored) and fill in.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-sonnet-5-5
EFFORT=medium
USE_SERVER_FALLBACK=true

# Local dev: the db container is published on localhost:5432.
# Inside docker compose the api service overrides this with the `db` hostname.
DATABASE_URL=postgresql://rca:rca@localhost:5432/rca

# Retrieval knobs (defaults shown)
TOP_K_BM25=50
TOP_K_DENSE=50
FUSED_K=30
RERANK_K=6
RERANK_THRESHOLD=-7.4

# Set to enable POST /ingest (send it as the X-Admin-Token header)
ADMIN_TOKEN=
MAX_CHUNKS_PER_DOC=0
